{
  // The worker is named for the product since D148. D100 had kept the original name, because a
  // new name makes Cloudflare deploy to a different worker; Workers Builds' preview uploads failed
  // on the old name once the repository moved, and the author chose the rename. Domains are
  // attached to the worker in the Cloudflare dashboard —
  // nedito.app as the canonical host, www.nedito.app as an alias the app itself redirects from
  // (src/app/originGuard.ts) — not declared here. myconifer.app is no longer served (D106).
  "name": "nedito",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Workers Logs, enabled in the dashboard and kept here because deploys are driven by this file:
  // without it, the next push would silently turn logging back off.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
